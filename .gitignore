# macOS
.DS_Store

# This gitignore file itself
.gitignore

# Python
__pycache__/
*.pyc

# VS Code
.vscode/

# Private/local files not for public repo
z_gitignored/

# Compiled Python bytecode (can be regenerated) - except release folder and scripts
*.mpy
!release/**/*.mpy
!scripts/**/*.mpy
!scripts/**/mpy-cross*

# Release zip files (generated locally, not tracked)
release zip files/

# Temporary extraction folder (used by loopster2initializer)
scripts/_zip_temp_extract/
